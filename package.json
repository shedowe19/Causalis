{
  "name": "causalis",
  "productName": "Causalis",
  "version": "0.3.0",
  "description": "Windows Chromium browser with Bitwarden and Vaultwarden as its only password manager",
  "main": "src/main.cjs",
  "license": "GPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node tools/check.cjs",
    "smoke": "electron . --smoke-test",
    "prepare:client": "node tools/prepare-client.cjs",
    "package:windows": "node tools/package.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.7.0"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "1.0.5"
  }
}
